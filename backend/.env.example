# ==========================================
# DUROZEN Backend - Environment Configuration
# ==========================================
# Copy this file to backend/.env and fill in strong, unique secrets.
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"

# PostgreSQL Connection URL
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_POSTGRES_PASSWORD@localhost:5432/durozen_db

# Security & Admin Authentication
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# Allowed CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
