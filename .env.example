# ==========================================
# DUROZEN Portfolio - Environment Configuration
# ==========================================
# Copy this file to .env and fill in strong, unique secrets before running.
# Generate SECRET_KEY with: openssl rand -hex 32
# (or: python -c "import secrets; print(secrets.token_hex(32))")

# Frontend (Next.js) Configuration
# Leave NEXT_PUBLIC_API_BASE_URL empty in Docker/Dokploy so API requests
# route via same-origin Next.js rewrites to the internal backend container.
NEXT_PUBLIC_API_BASE_URL=
BACKEND_URL=http://127.0.0.1:8000
DOCKER_BACKEND_URL=http://durozen-backend:8000

# Backend Server Configuration
PORT=8000

# Database Configuration (Docker & Local)
DB_BIND_IP=127.0.0.1
DB_PORT=5432
POSTGRES_DB=durozen_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD

# PostgreSQL Connection URL
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_POSTGRES_PASSWORD@localhost:5432/durozen_db

# Security & Admin Authentication
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# Allowed CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
